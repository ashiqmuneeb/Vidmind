# ==========================================
# VidMind Configuration
# ==========================================

# Server & Environment
APP_NAME="VidMind"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database & Storage
# Uses SQLite for zero-setup local storage, PostgreSQL URL compatible
DATABASE_URL="sqlite+aiosqlite:///./data/vidmind.db"
DATA_DIRECTORY="./data"

# Hardware Profile & Concurrency
# Options: auto, low, medium, high
HARDWARE_PROFILE="auto"
MAX_CONCURRENT_JOBS=2

# Transcription (faster-whisper)
# Models: tiny, base, small, medium, large-v3
TRANSCRIPTION_MODEL="base"
TRANSCRIPTION_DEVICE="cpu"
TRANSCRIPTION_COMPUTE_TYPE="int8"
TRANSCRIPTION_CPU_THREADS=3
TRANSCRIPTION_BEAM_SIZE=5
TRANSCRIPTION_VAD_FILTER=true

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"
LLM_PROVIDER="ollama"
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# Embeddings & Retrieval
# Lightweight CPU model (~80MB)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"
VECTOR_INDEX_TYPE="faiss"
TOP_K_RETRIEVAL=5

# Semantic Chunking & Chaptering
CHUNK_TARGET_MINUTES=10
CHUNK_MIN_MINUTES=5
CHUNK_MAX_MINUTES=15

# Visual Analysis & OCR (Optional modules)
ENABLE_VISION=false
ENABLE_OCR=false
VISION_MODEL="llava:7b"
FRAME_INTERVAL_SECONDS=30
OCR_ENGINE="tesseract"
